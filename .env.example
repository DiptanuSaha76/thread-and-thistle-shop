# Copy to .env (never commit .env). Values here are placeholders, not real keys.

# --- Public (sent to the browser; safe to expose) ------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server only (NEVER prefix these with VITE_) -------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Bypasses row-level security: only for trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (online payments). Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protects POST /api/cron/expire-orders (Authorization: Bearer <value>).
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# Mobile number verification by SMS (OneAPI). Leave empty to keep it switched off.
# Brand name: the sender/brand name OneAPI has approved for this shop (not "OnePayment").
ONEAPI_SMS_API_KEY=
ONEAPI_SMS_BRAND_NAME=
# Random secret, at least 32 characters (e.g. `openssl rand -hex 32`). Used to hash codes.
PHONE_OTP_SECRET=
# Optional: only if OneAPI gives you a different address. Default https://backend.oneapi.in/sms/sendotp
ONEAPI_SMS_ENDPOINT=

# Shiprocket order tracking (read-only). Set ENABLED=true only after confirming the
# Shiprocket plan includes API access. Use the dedicated API user (Settings -> API).
SHIPROCKET_TRACKING_ENABLED=false
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=

# Only for local database tooling (drizzle-kit). Not needed by the website.
DATABASE_URL=
